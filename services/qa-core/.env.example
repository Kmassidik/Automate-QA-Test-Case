# qa-core — gatekeeper service (UI, queue, SSE, exports). Copy to .env (gitignored).
QA_CORE_ADDR=:8080

# qa-ai location. In dev: http://localhost:8081. In Docker (compose): http://qa-ai:8081.
QA_AI_URL=http://localhost:8081

# REQUIRED — single shared access code (PRD §5.5). No default; the service
# refuses to start without it. 12-factor: keep it here, never in the repo.
ACCESS_CODE=change-me

# Queue backpressure threshold (submissions beyond this are asked to retry).
QUEUE_BUFFER=256

# ETA = rolling average of the last N completed jobs (PRD §5.4).
ETA_WINDOW=20

# Upper bound on a single generation (also the per-job worker timeout).
QA_AI_TIMEOUT=200s
