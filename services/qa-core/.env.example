# qa-core — gatekeeper service (UI, queue, SSE, exports). Copy to .env (gitignored).
QA_CORE_ADDR=:8080

# qa-ai location. In dev: http://localhost:8081. In Docker (compose): http://qa-ai:8081.
QA_AI_URL=http://localhost:8081

# REQUIRED — single shared access code (PRD §5.5). No default; the service
# refuses to start without it. 12-factor: keep it here, never in the repo.
ACCESS_CODE=change-me

# Queue backpressure threshold (submissions beyond this are asked to retry).
QUEUE_BUFFER=256

# ETA = rolling average of the last N completed jobs (PRD §5.4).
ETA_WINDOW=20

# Timeouts. The batched generator makes MANY sequential qa-ai calls per job
# (analysis + one per acceptance criterion + aux), so the whole-job budget must
# be much larger than a single call — otherwise long multi-AC runs get canceled
# mid-flight ("context canceled").
STAGE_TIMEOUT=300s   # one qa-ai call (a single pipeline stage)
JOB_TIMEOUT=1800s    # the whole batched generation (all stages)
# QA_AI_TIMEOUT=300s # deprecated alias for STAGE_TIMEOUT (kept for back-compat)

# Optional: write a markdown snapshot of each job's work-in-progress result to
# this dir (one file per job, updated after every step). Empty = in-memory only
# (the PRD's no-persistence default). Handy for watching the batched pipeline.
# SNAPSHOT_DIR=./tmp/snapshots
