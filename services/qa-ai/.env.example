# qa-ai — stateless generation service. Copy to .env (gitignored).
QA_AI_ADDR=:8081

# Native Ollama on the host. In dev: http://localhost:11434.
# In Docker (compose): http://host.docker.internal:11434.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=8192

# JSON validation retry cap (PRD §7/§8): total LLM calls = 1 + MAX_JSON_RETRIES.
MAX_JSON_RETRIES=3

# Per-generation timeout (one 7B pass on a 16GB box is ~30–90s; leave headroom).
GEN_TIMEOUT=180s

# Auto-pull the model on startup if it's missing (daemon must be reachable).
# Set false to require a manual `ollama pull`.
OLLAMA_AUTO_PULL=true

# Backoff between warmup attempts while Ollama is unreachable.
WARMUP_RETRY=5s

# Force "in container" detection (also auto-detected via /.dockerenv). Affects
# only the OS-aware Ollama guidance shown when the daemon is unreachable.
# QA_IN_CONTAINER=1
