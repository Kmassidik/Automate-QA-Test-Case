# qa-ai — stateless generation service. Copy to .env (gitignored).
QA_AI_ADDR=:8081

# Native Ollama on the host. In dev: http://localhost:11434.
# In Docker (compose): http://host.docker.internal:11434.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=8192

# JSON validation retry cap (PRD §7/§8): total LLM calls = 1 + MAX_JSON_RETRIES.
MAX_JSON_RETRIES=3

# Per-generation timeout (one 7B pass on a 16GB box is ~30–90s; leave headroom).
GEN_TIMEOUT=180s
