# Secrets (12-factor; access code lives here, never in repo)
.env
**/.env
!**/.env.example

# Go build artifacts
bin/
*.exe
*.test
*.out

# Air hot-reload
tmp/
**/tmp/

# Editor / OS
.DS_Store
.idea/
.vscode/

# Nix
result
result-*

# Editable form options store (runtime state)
data/

# Runtime logs
log/
*.log

# Node test harness (Playwright — local dev/QA only, not part of the app)
node_modules/
package.json
package-lock.json

# Deployment / internal docs (site-specific or internal notes — kept local, not published)
docs/RUNBOOK.md
review.md

# Internal MOM template / sample meeting material (real names + company info — keep local)
source template need to be same as layout/
*.docx
*.docx.pdf
*.docx.zip
